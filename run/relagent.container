[Unit]
Description=Relagent engine

[Container]
Image=registry.gitlab.com/rmmsr/relagent:0.1.10-pre
AutoUpdate=registry
PublishPort=8000:8000
ReadOnly=true
UserNS=keep-id:uid=1000,gid=1000
Volume=%h/.local/share/relagent/settings.ini:/app/.local/share/relagent/settings.ini:ro
Volume=%h/.local/share/relagent/data:/app/.local/share/relagent/data:rw

[Install]
WantedBy=default.target

[Service]
Restart=always
